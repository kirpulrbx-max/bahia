{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Bahia",
    "homepage": "https://github.com/kirpulrbx-max/bahia",
    "shortDescription": "Dock estilo macOS para Windows",
    "category": "Utility",
    "externalBin": [
      "binaries/bahia"
    ],
    "windows": {
      "nsis": {
        "template": "installer/installer.nsi",
        "installerHooks": "installer/hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "English",
          "Spanish",
          "French"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  }
}
